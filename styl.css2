body {
    font-family: Arial, Helvetica, sans-serif;
    background-color: #f2f5f9;
    margin: 0;
    padding: 30px;
}
h1 {
    text-align: center;
    color: #003366;
}
form {
    width: 700px;
    margin: auto;
    background: white;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(0,0,0,0.2);
}
fieldset {
    border: 2px solid #4CAF50;
    border-radius: 8px;
    margin-bottom: 20px;
    padding: 15px;
}
legend {
    color: #4CAF50;
    font-weight: bold;
    padding: 0 10px;
}
input[type="text"],
input[type="email"],
input[type="date"],
input[type="password"],
select {
    width: 100%;
    padding: 8px;
    margin-top: 5px;
    margin-bottom: 12px;
    border: 1px solid #ccc;
    border-radius: 5px;
    box-sizing: border-box;
}
input[type="file"] {
    margin-top: 10px;
}
input[type="radio"],
input[type="checkbox"] {
    margin-right: 5px;
}
input[type="submit"] {
    width: 100%;
    background-color: #4CAF50;
    color: white;
    border: none;
    padding: 12px;
    font-size: 16px;
    border-radius: 5px;
    cursor: pointer;
}
input[type="submit"]:hover {
    background-color: #388E3C;
}
